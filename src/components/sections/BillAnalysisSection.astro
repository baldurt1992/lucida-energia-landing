---
import { ChartNoAxesCombined, Gauge, ReceiptText, Zap } from "@lucide/astro";
---

<section id="factura" class="bill" aria-labelledby="factura-titulo">
  <div class="shell">
    <header class="intro">
      <p class="kicker">Tu consumo, sin letra pequeña</p>
      <h2 id="factura-titulo">Abrimos tu factura</h2>
    </header>

    <div class="bill-scene">
      <aside class="inspection" aria-label="Puntos que revisamos">
        <article>
          <Zap aria-hidden="true" size={22} stroke-width={1.7} />
          <div>
            <h3>Energía consumida</h3>
            <p>Cuánto usaste y a qué precio se facturó cada kWh.</p>
          </div>
        </article>
        <article>
          <Gauge aria-hidden="true" size={22} stroke-width={1.7} />
          <div>
            <h3>Potencia contratada</h3>
            <p>El coste fijo y si se ajusta al uso real del suministro.</p>
          </div>
        </article>
        <article>
          <ReceiptText aria-hidden="true" size={22} stroke-width={1.7} />
          <div>
            <h3>Impuestos y extras</h3>
            <p>Qué es obligatorio y qué servicio adicional se puede revisar.</p>
          </div>
        </article>
      </aside>

      <figure class="invoice" data-bill-paper data-reveal="mask">
        <figcaption class="sample-label">Ejemplo visual</figcaption>

        <header class="invoice-head">
          <div class="invoice-brand">
            <span class="brand-mark" aria-hidden="true"></span>
            <div>
              <p class="brand-name">LÚCIDA</p>
              <p class="brand-service">Suministro eléctrico</p>
            </div>
          </div>
          <div class="invoice-meta">
            <p><span>Factura</span> LC-2408-017</p>
            <p><span>Periodo</span> 01–31 agosto</p>
          </div>
        </header>

        <div class="invoice-summary">
          <div>
            <p class="summary-label">Total del periodo</p>
            <p class="summary-total">84,37 €</p>
          </div>
          <div class="summary-consumption">
            <p>Consumo</p>
            <strong>286 kWh</strong>
          </div>
        </div>

        <section class="history" aria-labelledby="historial-titulo">
          <div class="history-head">
            <div>
              <p class="document-label">Evolución del consumo</p>
              <h3 id="historial-titulo">Últimos seis meses</h3>
            </div>
            <ChartNoAxesCombined
              aria-hidden="true"
              size={24}
              stroke-width={1.6}
            />
          </div>
          <svg
            class="consumption-chart"
            viewBox="0 0 520 150"
            role="img"
            aria-labelledby="chart-title chart-description"
          >
            <title id="chart-title">Consumo eléctrico de marzo a agosto</title>
            <desc id="chart-description">
              El consumo sube de marzo a mayo, desciende en junio y vuelve a
              subir hasta 286 kilovatios hora en agosto.
            </desc>
            <g class="chart-grid" aria-hidden="true">
              <path d="M20 25H500 M20 75H500 M20 125H500"></path>
            </g>
            <path
              class="chart-area"
              d="M20 105 L116 83 L212 57 L308 91 L404 70 L500 42 L500 125 L20 125 Z"
              aria-hidden="true"></path>
            <path
              class="chart-line"
              d="M20 105 L116 83 L212 57 L308 91 L404 70 L500 42"
              aria-hidden="true"></path>
            <g class="chart-points" aria-hidden="true">
              <circle cx="20" cy="105" r="4"></circle>
              <circle cx="116" cy="83" r="4"></circle>
              <circle cx="212" cy="57" r="4"></circle>
              <circle cx="308" cy="91" r="4"></circle>
              <circle cx="404" cy="70" r="4"></circle>
              <circle cx="500" cy="42" r="5"></circle>
            </g>
          </svg>
          <div class="chart-labels" aria-hidden="true">
            <span>Mar</span><span>Abr</span><span>May</span><span>Jun</span
            ><span>Jul</span><span>Ago</span>
          </div>
        </section>

        <section class="breakdown" aria-labelledby="desglose-titulo">
          <div class="breakdown-head">
            <p class="document-label">Detalle</p>
            <h3 id="desglose-titulo">Desglose de la factura</h3>
          </div>
          <dl>
            <div>
              <dt>
                <span>Energía consumida</span><small
                  >286 kWh × 0,142 €/kWh</small>
              </dt>
              <dd>40,61 €</dd>
            </div>
            <div>
              <dt><span>Potencia contratada</span><small>4,6 kW</small></dt>
              <dd>21,84 €</dd>
            </div>
            <div>
              <dt>
                <span>Impuestos y alquiler</span><small
                  >Contador e impuestos aplicables</small>
              </dt>
              <dd>15,42 €</dd>
            </div>
            <div class="service-row">
              <dt>
                <span>Servicio de mantenimiento</span><small
                  >Concepto revisable</small>
              </dt>
              <dd>6,50 €</dd>
            </div>
          </dl>
        </section>

        <footer class="invoice-foot">
          <p>Potencia actual: <strong>4,6 kW</strong></p>
          <p>Tarifa: <strong>precio fijo 24 h</strong></p>
        </footer>
      </figure>
    </div>
  </div>
</section>

<style>
  .bill {
    padding-block: var(--space-section);
    overflow: clip;
    background:
      radial-gradient(
        circle at 78% 20%,
        rgb(198 245 49 / 8%),
        transparent 28rem
      ),
      var(--color-petroleum);
    color: var(--color-mineral);
  }

  .shell {
    width: min(100%, var(--page-max));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .intro {
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .kicker,
  .intro h2,
  .inspection h3,
  .inspection p,
  .invoice p,
  .invoice h3,
  .invoice dl {
    margin: 0;
  }

  .kicker {
    margin-bottom: 0.8rem;
    color: var(--color-electric);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .intro h2 {
    max-width: 10ch;
    font-size: clamp(2.8rem, 7vw, 6rem);
  }

  .bill-scene {
    display: grid;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .inspection {
    display: grid;
    gap: 1px;
    order: 2;
    background: var(--color-line-deep);
    border-block: 1px solid var(--color-line-deep);
  }

  .inspection article {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.3rem;
    background: var(--color-petroleum);
  }

  .inspection svg {
    margin-top: 0.15rem;
    color: var(--color-electric);
  }

  .inspection h3 {
    font-size: 1.1rem;
    line-height: 1.25;
  }

  .inspection p {
    max-width: 34ch;
    margin-top: 0.35rem;
    color: var(--color-mineral-soft);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .invoice {
    position: relative;
    order: 1;
    width: 100%;
    margin: 0;
    background: #fffefb;
    color: var(--color-ink);
    box-shadow:
      18px 22px 0 rgb(7 24 22 / 55%),
      0 30px 70px rgb(0 0 0 / 25%);
  }

  .invoice::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(
      rgb(16 33 28 / 7%) 0.45px,
      transparent 0.45px
    );
    background-size: 5px 5px;
    opacity: 0.2;
  }

  .sample-label {
    position: absolute;
    z-index: 2;
    top: 0;
    right: 0;
    padding: 0.45rem 0.7rem;
    background: var(--color-electric);
    color: var(--color-electric-ink);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .invoice-head,
  .invoice-summary,
  .history,
  .breakdown,
  .invoice-foot {
    position: relative;
    z-index: 1;
  }

  .invoice-head {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.4rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--color-line-mineral);
  }

  .invoice-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-mark {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50% 50% 50% 0;
    background: var(--color-petroleum);
    transform: rotate(-35deg);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .brand-service {
    margin-top: 0.1rem !important;
    color: var(--color-muted);
    font-size: 0.76rem;
  }

  .invoice-meta {
    display: grid;
    gap: 0.25rem;
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
  }

  .invoice-meta span {
    display: inline-block;
    min-width: 4.25rem;
    color: var(--color-muted);
  }

  .invoice-summary {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.4rem, 4vw, 2.5rem);
    background: var(--color-petroleum);
    color: var(--color-mineral);
  }

  .summary-label,
  .summary-consumption p,
  .document-label {
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .invoice-summary .summary-label,
  .invoice-summary .summary-consumption p {
    color: var(--color-mineral-soft);
  }

  .summary-total {
    margin-top: 0.2rem !important;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 7vw, 4.1rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .summary-consumption {
    text-align: right;
  }

  .summary-consumption strong {
    display: block;
    margin-top: 0.25rem;
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
  }

  .history,
  .breakdown {
    padding: clamp(1.4rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--color-line-mineral);
  }

  .history-head,
  .breakdown-head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .history h3,
  .breakdown h3 {
    margin-top: 0.25rem;
    font-size: 1.25rem;
  }

  .history-head > svg {
    color: var(--color-petroleum);
  }

  .consumption-chart {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 1.25rem;
    overflow: visible;
  }

  .chart-grid path {
    fill: none;
    stroke: rgb(16 33 28 / 12%);
    stroke-width: 1;
  }

  .chart-area {
    fill: rgb(198 245 49 / 20%);
  }

  .chart-line {
    fill: none;
    stroke: var(--color-petroleum);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chart-points circle {
    fill: var(--color-electric);
    stroke: var(--color-petroleum);
    stroke-width: 3;
  }

  .chart-labels {
    display: flex;
    justify-content: space-between;
    color: var(--color-muted);
    font-size: 0.68rem;
  }

  .breakdown dl {
    margin-top: 1.25rem;
  }

  .breakdown dl > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    padding-block: 0.8rem;
    border-top: 1px solid var(--color-line-mineral);
  }

  .breakdown dt span,
  .breakdown dt small {
    display: block;
  }

  .breakdown dt span {
    font-weight: 600;
  }

  .breakdown dt small {
    margin-top: 0.2rem;
    color: var(--color-muted);
  }

  .breakdown dd {
    margin: 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .service-row {
    background: rgb(198 245 49 / 16%);
    margin-inline: -0.7rem;
    padding-inline: 0.7rem;
  }

  .invoice-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    padding: 1rem clamp(1.4rem, 4vw, 2.5rem);
    color: var(--color-muted);
    font-size: 0.72rem;
  }

  .invoice-foot strong {
    color: var(--color-ink);
  }

  @media (min-width: 48rem) {
    .invoice-head {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  @media (min-width: 64rem) {
    .bill-scene {
      grid-template-columns: minmax(15rem, 0.55fr) minmax(32rem, 1.45fr);
    }

    .inspection {
      position: sticky;
      top: calc(var(--header-offset) + 2rem);
      order: 1;
      margin-top: 6rem;
    }

    .invoice {
      order: 2;
    }
  }

  @media (max-width: 30rem) {
    .invoice-summary {
      align-items: start;
      flex-direction: column;
    }

    .summary-consumption {
      text-align: left;
    }
  }

  @media (forced-colors: active) {
    .invoice,
    .inspection article {
      border: 1px solid CanvasText;
    }
  }
</style>
