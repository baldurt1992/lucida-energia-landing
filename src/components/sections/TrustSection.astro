---
const commitments = [
  {
    title: "Consulta inicial gratuita",
    text: "La primera revisión no tiene coste ni incluye una contratación automática.",
    primary: true,
  },
  {
    title: "Proceso explicado paso a paso",
    text: "Ves qué se analiza y qué recibes antes de dejar tus datos.",
    primary: false,
  },
  {
    title: "Tratamiento responsable de los datos",
    text: "Pedimos solo la información necesaria para entender tu caso y responder a tu solicitud.",
    primary: false,
  },
  {
    title: "Recomendaciones en lenguaje llano",
    text: "El resultado se explica para decidir, sin jerga técnica de más.",
    primary: false,
  },
] as const;
---

<section class="trust" id="confianza" lang="es" aria-labelledby="confianza-titulo">
  <div class="shell">
    <header class="intro">
      <h2 id="confianza-titulo">Compromisos de la consulta</h2>
      <p class="lede">
        Cuatro condiciones que puedes comprobar. Esta página no incluye
        testimonios ni cifras de ahorro.
      </p>
    </header>
    <dl>
      {
        commitments.map((item) => (
          <div class:list={["item", { primary: item.primary }]}>
            <dt>{item.title}</dt>
            <dd>{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .trust {
    box-sizing: border-box;
    background: var(--color-petrol, #0f3d36);
    color: var(--color-mineral, #f3f0e8);
    font-family: var(--font-body, "Public Sans", sans-serif);
    padding-block: var(--space-section, clamp(4.5rem, 8vw, 7.5rem));
    border-top: 1px solid var(--color-sky, #d5e6ea);
  }

  .trust *,
  .trust *::before,
  .trust *::after {
    box-sizing: border-box;
  }

  .trust :where(h2, p, dl, dt, dd) {
    margin: 0;
  }

  .shell {
    width: min(100%, var(--container, var(--page-max)));
    margin-inline: auto;
    padding-inline: var(--gutter, clamp(1.25rem, 4vw, 3.5rem));
  }

  h2,
  dt {
    font-family: var(--font-display, Archivo, sans-serif);
    font-weight: 640;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  h2 {
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    max-width: 14em;
  }

  .lede {
    margin-top: 1.25rem;
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-mineral, #f3f0e8) 84%, var(--color-sky, #d5e6ea));
  }

  dl {
    display: grid;
    gap: 1.75rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .item {
    min-width: 0;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-mineral, #f3f0e8) 28%, transparent);
  }

  dt {
    font-size: clamp(1.35rem, 2vw, 1.7rem);
  }

  .primary dt {
    font-size: clamp(1.85rem, 3vw, 2.8rem);
  }

  dd {
    margin-top: 0.75rem;
    max-width: 46ch;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-mineral, #f3f0e8) 86%, var(--color-sky, #d5e6ea));
  }

  @media (min-width: 48rem) {
    dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem 2.25rem;
    }

    .primary {
      grid-column: 1 / -1;
    }
  }
</style>
