---
/** Primera escena. La promesa y las acciones están en HTML; la foto no tapa el texto. */

import { Picture } from "astro:assets";
import heroImage from "../../assets/images/hero-home-energy.jpg";
---

<section class="hero" id="inicio" aria-labelledby="hero-titulo">
  <div class="hero-media" data-hero-media>
    <!--
      Fotografía descargada como asset local. Fuente: Pexels 4050417.
      https://www.pexels.com/photo/4050417/
    -->
    <Picture
      class="hero-photo"
      src={heroImage}
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[480, 720, 840, 1280, 1920]}
      sizes="100vw"
      quality={60}
      alt="Persona en casa, sentada junto a una ventana con luz natural, en una habitación con radiador."
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="hero-panel surface-petroleum" data-hero-copy>
    <p class="hero-kicker">Revisión energética</p>
    <h1 id="hero-titulo">Tu factura debería explicarse sola</h1>
    <p class="hero-lede">
      Revisamos tu factura de luz o gas y te explicamos el contrato en claro,
      con una recomendación adaptada a tu caso.
    </p>
    <div class="hero-actions" role="group" aria-label="Acciones">
      <a class="btn btn-primary" href="#consulta">Revisar mi factura gratis</a>
      <a class="btn btn-secondary" href="#como-funciona">Cómo funciona</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - var(--header-offset));
    min-height: calc(100svh - var(--header-offset));
    background: var(--color-petroleum-deep);
  }

  .hero-media {
    position: relative;
    flex: 1 1 auto;
    min-height: clamp(9.5rem, 26vh, 20rem);
    overflow: hidden;
    background: var(--color-petroleum-deep);
    color: var(--color-mineral);
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 48% 22%;
  }

  .hero-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
    width: 100%;
    padding: 1.15rem var(--gutter)
      max(1.25rem, env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--color-line-deep);
  }

  .hero-kicker {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    color: var(--color-mineral-soft);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  h1 {
    max-width: 100%;
    color: var(--color-mineral);
    font-size: var(--text-hero);
    font-weight: 600;
  }

  .hero-lede {
    max-width: 34rem;
    color: var(--color-mineral-soft);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    width: 100%;
  }

  @media (max-width: 39.99rem) {
    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .btn {
      width: 100%;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      justify-content: flex-end;
    }

    .hero-media {
      position: absolute;
      inset: 0;
      flex: none;
      min-height: 0;
    }

    .hero-photo {
      object-position: 36% 8%;
    }

    .hero-panel {
      position: relative;
      z-index: 1;
      width: min(36.5rem, 48vw);
      padding: clamp(1.75rem, 3vw, 2.75rem);
      border-right: 1px solid var(--color-line-deep);
    }
  }
</style>
