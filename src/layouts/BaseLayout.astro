---
import "../styles/global.css";
import SiteHeader from "../components/layout/SiteHeader.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "LÚCIDA — Asesoría energética",
  description = "Revisamos tu factura de luz o gas y te la explicamos en claro. Consulta gratuita para hogares, autónomos y pymes.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e2c26" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/archivo-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/public-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
